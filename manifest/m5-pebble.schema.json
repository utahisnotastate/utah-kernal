{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/utahisnotastate/utah-kernal/manifest/m5-pebble.schema.json",
  "title": "M5-Pebble Hardware Manifest",
  "description": "Resonance-tuned hardware profile for Utah-OS on M5Stack-class edge devices.",
  "type": "object",
  "required": ["device_id", "resonant_network_frequency", "display", "chrono"],
  "properties": {
    "device_id": {
      "type": "string",
      "description": "Unique node identifier (e.g. m5stack-cores3-001)"
    },
    "resonant_network_frequency": {
      "type": "integer",
      "minimum": 1,
      "description": "Zero-Point mesh tuning frequency (default Schumann-scale: 7830000000)"
    },
    "display": {
      "type": "object",
      "required": ["width", "height", "framebuffer_format"],
      "properties": {
        "width": { "type": "integer", "default": 800 },
        "height": { "type": "integer", "default": 600 },
        "framebuffer_format": {
          "type": "string",
          "enum": ["bgra8888"],
          "default": "bgra8888"
        },
        "physical_base": {
          "type": ["string", "null"],
          "description": "Optional MMIO framebuffer address (hex string)"
        }
      }
    },
    "chrono": {
      "type": "object",
      "properties": {
        "temporal_sequencing_enabled": { "type": "boolean", "default": true },
        "prediction_depth": { "type": "integer", "minimum": 1, "maximum": 64, "default": 32 }
      }
    },
    "thermodynamic": {
      "type": "object",
      "properties": {
        "cooling_mode": { "type": "boolean", "default": true },
        "idle_harvest_ticks": { "type": "integer", "default": 8 }
      }
    },
    "ghost_daemon": {
      "type": "object",
      "properties": {
        "phantom_sleep_enabled": { "type": "boolean", "default": true },
        "m5stack_light_sleep": { "type": "boolean", "default": true }
      }
    }
  }
}
